# 로드밸런서 설정 — app1 / app2 앞단.
#
# nginx 공식 이미지가 /etc/nginx/templates/*.template 를 envsubst 로 렌더링해
# /etc/nginx/conf.d/ 에 떨어뜨린다. 그래서 ${LB_UPSTREAM_HEADER} 만 치환된다
# ($upstream_addr 같은 nginx 변수는 환경변수가 아니라 그대로 남는다).

upstream shop_app {
    # 기본 라운드로빈을 그대로 쓴다. least_conn 이 아니라 RR 인 이유는
    # **분산 자체를 검증**해야 하기 때문이다 — RR 은 분포가 예측 가능해서
    # "한쪽으로만 갔다"를 즉시 알 수 있다.
    server app1:8080 max_fails=3 fail_timeout=10s;
    server app2:8080 max_fails=3 fail_timeout=10s;

    # 업스트림 커넥션 재사용. 요청마다 TCP 핸드셰이크를 새로 하지 않는다.
    keepalive 32;
}

server {
    listen 80;

    # 헬스체크용. LB 자신이 살아 있는지와 업스트림 상태를 구분한다
    location = /lb-health {
        access_log off;
        return 200 "lb ok\n";
    }

    location / {
        proxy_pass http://shop_app;

        # keepalive 를 쓰려면 HTTP/1.1 + Connection 헤더 비우기가 필요하다
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 죽은 인스턴스를 건너뛴다.
        # ★ non_idempotent 를 **넣지 않는다.** 넣으면 POST 도 재시도되고,
        #   POST /api/customers/order 가 두 번 실행되어 중복 주문이 된다.
        #   nginx 기본값은 비멱등 요청을 재시도하지 않는다 — 그 기본값이 옳다.
        #   (DECISIONS.md 14절에서 서버 자동 재시도를 넣지 않기로 한 것과 같은 판단이
        #    LB 계층에도 적용된다)
        proxy_next_upstream error timeout http_502 http_503 http_504;
        proxy_connect_timeout 2s;

        # 인스턴스 식별 헤더 — 기본은 비어 있다(=헤더 없음).
        # 내부 IP·포트를 상시 노출하는 것은 Phase 2에서 줄여온 정보 노출면과 어긋난다.
        # 측정할 때만 LB_EXPOSE_UPSTREAM=1 로 켠다. 근거는 DECISIONS.md 27절.
        ${LB_UPSTREAM_HEADER}
    }
}
