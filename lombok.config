# Lombok이 생성한 메서드에 @lombok.Generated를 붙인다.
# JaCoCo는 이 어노테이션이 붙은 메서드를 커버리지 집계에서 자동으로 제외한다.
#
# 이게 없으면 getter·builder·equals 같은 생성 코드가 분모에 들어간다.
# 그 줄들을 덮으려고 테스트를 쓰면 "테스트를 위한 테스트"가 되고,
# 안 덮으면 커버리지가 낮게 나와 숫자가 실제 검증 수준을 왜곡한다.
# 클래스 단위 excludes보다 정밀하다 — 같은 클래스 안의 '사람이 쓴 코드'는 그대로 집계된다.
lombok.addLombokGeneratedAnnotation = true

# 이 파일이 설정 탐색의 최상위임을 명시한다 (상위 디렉터리를 더 뒤지지 않는다)
config.stopBubbling = true
