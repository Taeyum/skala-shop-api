# docker compose가 자동으로 읽는 파일. 복사해서 쓴다:
#   cp .env.example .env
# .env는 gitignore 대상이라 실제 값은 커밋되지 않는다.
#
# 아래 값을 그대로 둬도 동작한다. 포트가 이미 사용 중일 때만 바꾸면 된다.

# 호스트에 노출할 DB 포트.
# 기본값이 5432가 아닌 이유는 DECISIONS.md 7절 참조.
# 이 값도 이미 쓰이고 있다면 비어 있는 포트로 바꾼다 (예: 15432).
# bootRun으로 앱을 직접 띄울 때도 같은 값을 넘겨야 한다:
#   POSTGRES_PORT=15432 ./gradlew bootRun
POSTGRES_PORT=5433

# 앱 포트
SERVER_PORT=8080

# DB 이름 · 계정 (개발 전용 값. 운영 크리덴셜을 여기 두지 않는다)
POSTGRES_DB=shopdb
POSTGRES_USER=shop
POSTGRES_PASSWORD=shoppw

# JWT 서명 키. HS256은 최소 256비트(32바이트) 이상을 요구한다.
# 짧으면 기동 시 WeakKeyException으로 실패한다.
# 운영에서는 반드시 바꾼다 — 아래 값은 이름 그대로 개발 전용이다
JWT_SECRET=dev-only-do-not-use-in-production-0123456789

# 인증 쿠키의 Secure 플래그. 이 스택은 HTTP라 기본 false다.
# HTTPS(리버스 프록시 등) 뒤에 배포하면 true로 켠다 — 켜지 않으면 쿠키가 평문으로 오간다
COOKIE_SECURE=false
